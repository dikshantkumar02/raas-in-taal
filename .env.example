# -----------------------------------------------------------------------------
# RAAS IN TAAL — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# IMPORTANT: Never commit .env or .env.local to Git. Keep private keys server-side.
# -----------------------------------------------------------------------------

# NEXT PUBLIC APP URL & API BASE
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: Set only if frontend is hosted on a separate domain from the backend. Leave empty for same-origin.
NEXT_PUBLIC_API_BASE_URL=""
# Multi-subdomain CORS configuration (comma-separated allowed origins)
ALLOWED_ORIGINS="https://raasintaal.in,https://staff.raasintaal.in,https://admin.raasintaal.in"
NEXT_PUBLIC_STAFF_URL="https://staff.raasintaal.in"

# SUPABASE CONFIGURATION (POSTGRESQL & AUTH)
# Free Tier: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# RAZORPAY PAYMENT GATEWAY CONFIGURATION
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_optional"

# TRANSACTIONAL EMAIL PROVIDER (Resend & Gmail SMTP Fallback)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_placeholder_secret_key"
EMAIL_API_KEY="re_placeholder_secret_key"
EMAIL_FROM="onboarding@resend.dev"
EMAIL_FROM_ADDRESS="onboarding@resend.dev"
EMAIL_FROM_NAME="Raas in Taal"
# Backup Gmail SMTP (for free domain-less delivery):
GMAIL_USER="your_event_email@gmail.com"
GMAIL_APP_PASSWORD="your_google_app_password"

# ADMIN & STAFF SECURITY CREDENTIALS
# Used for server-side auth bootstrap and session JWT verification
ADMIN_SECRET_KEY="super_secure_random_admin_secret_minimum_32_characters_long"
STAFF_PIN="202618"

# EVENT SETTINGS (Can also be stored in DB configuration table)
EVENT_MAX_ATTENDEES="500"
RESERVATION_EXPIRY_MINUTES="10"
