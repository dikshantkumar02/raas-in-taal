# -----------------------------------------------------------------------------
# RAAS IN TAAL — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# IMPORTANT: Never commit .env or .env.local to Git. Keep private keys server-side.
# -----------------------------------------------------------------------------

# NEXT PUBLIC APP URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (POSTGRESQL & AUTH)
# Free Tier: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# PHONEPE PAYMENT GATEWAY CONFIGURATION
# Documentation: https://developer.phonepe.com/
# Use 'SANDBOX' or 'PRODUCTION'
PHONEPE_ENV="SANDBOX"
PHONEPE_MERCHANT_ID="PGTESTPAYUAT"
PHONEPE_SALT_KEY="099eb0cd-02cf-4e2a-8aca-3e6c6aff0399"
PHONEPE_SALT_INDEX="1"
# PhonePe Sandbox Host: https://api-preprod.phonepe.com/apis/pg-sandbox
# PhonePe Production Host: https://api.phonepe.com/apis/pg
PHONEPE_HOST_URL="https://api-preprod.phonepe.com/apis/pg-sandbox"

# TRANSACTIONAL EMAIL PROVIDER (Resend / Brevo)
# Free Tier: Resend (3,000 emails/mo) or Brevo (300 emails/day)
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_placeholder_secret_key"
EMAIL_FROM_ADDRESS="tickets@raasintaal.com"
EMAIL_FROM_NAME="Raas in Taal - Chaos and Chill"

# ADMIN & STAFF SECURITY CREDENTIALS
# Used for server-side auth bootstrap and session JWT verification
ADMIN_SECRET_KEY="super_secure_random_admin_secret_minimum_32_characters_long"
STAFF_PIN="202618"

# EVENT SETTINGS (Can also be stored in DB configuration table)
EVENT_MAX_ATTENDEES="500"
RESERVATION_EXPIRY_MINUTES="10"
